rules_version = '2';

// Security rules for the menu orders. Paste into Firebase console: Firestore Database > Rules > Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Who can see and update each restaurant's orders. Staff sign in with this email (or, for a username
    // like "cafe52", the staff screen uses "cafe52@cafe52.staff.invalid"). To add someone, add their
    // login here and create it under Authentication > Users with a password.
    function staffEmails() {
      return {
        'cafe52': ['cafe52@gmail.com']
      };
    }

    function isStaff(rid) {
      return request.auth != null
        && rid in staffEmails()
        && request.auth.token.email in staffEmails()[rid];
    }

    // Today's code lives in a staff-only document; guests never read it, the rules check it for them
    function accessDoc(rid) {
      return /databases/$(database)/documents/restaurants/$(rid)/private/access;
    }
    function statusDoc(rid) {
      return /databases/$(database)/documents/restaurants/$(rid)/public/status;
    }
    function codeOk(rid, code) {
      return exists(accessDoc(rid))
        && get(accessDoc(rid)).data.code == code
        && get(accessDoc(rid)).data.validUntil > request.time;
    }
    function orderingOpen(rid) {
      return !(exists(statusDoc(rid)) && get(statusDoc(rid)).data.orderingPaused == true);
    }

    match /restaurants/{rid}/orders/{orderId} {
      // Guests: place a new order. Only well-formed orders for a known restaurant, with today's code,
      // while ordering isn't paused, get in.
      allow create: if rid in staffEmails()
        && orderingOpen(rid)
        && request.resource.data.keys().hasAll(['restaurant', 'table', 'code', 'items', 'notes', 'subtotal', 'serviceCharge', 'total', 'createdAt', 'placedAt', 'status'])
        && request.resource.data.keys().hasOnly(['restaurant', 'table', 'code', 'items', 'notes', 'phone', 'subtotal', 'serviceCharge', 'total', 'createdAt', 'placedAt', 'status'])
        // optional Indian mobile number for the bill (10 digits, starting 6–9)
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.matches('^[6-9][0-9]{9}$')))
        && request.resource.data.code is string
        && codeOk(rid, request.resource.data.code)
        && request.resource.data.restaurant == rid
        && request.resource.data.status == 'new'
        && request.resource.data.placedAt == request.time
        && request.resource.data.table is string
        && request.resource.data.table.matches('^[A-Z]{0,3}[0-9]{1,4}$')
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 60
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 300
        && request.resource.data.subtotal is number
        && request.resource.data.serviceCharge is number
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.total < 1000000
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40;

      // Guests: follow their own order. Order ids are random 20-character codes, so only the phone
      // that placed an order knows its id. Listing all orders is staff only.
      allow get: if true;
      allow list: if isStaff(rid);

      // Staff: move an order along (or cancel it), or mark it paid / not paid. Nothing else about the order can be changed.
      allow update: if isStaff(rid) && (
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusAt', 'statusBy'])
          && request.resource.data.status in ['new', 'accepted', 'preparing', 'served', 'cancelled']
          && request.resource.data.statusAt == request.time
          && request.resource.data.statusBy == request.auth.token.email)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paid', 'paidAt', 'paidBy'])
          && request.resource.data.paid is bool
          && request.resource.data.paidAt == request.time
          && request.resource.data.paidBy == request.auth.token.email));

      allow delete: if false;
    }

    // Today's code: staff only. It must be 4 digits and expire within 2 days.
    match /restaurants/{rid}/private/access {
      allow read: if isStaff(rid);
      allow create, update: if isStaff(rid)
        && request.resource.data.keys().hasOnly(['code', 'validUntil', 'updatedAt', 'updatedBy'])
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[0-9]{4}$')
        && request.resource.data.validUntil is timestamp
        && request.resource.data.validUntil > request.time
        && request.resource.data.validUntil < request.time + duration.value(2, 'd')
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    // "Is this today's code?" Guests try to read /codecheck/{code}. Nothing is stored there: the read is
    // allowed (and returns "not found") when the code is right, and refused when it's wrong, so the
    // menu can check a code up front without anyone being able to read the code itself.
    match /restaurants/{rid}/codecheck/{code} {
      allow get: if codeOk(rid, code);
    }

    // The pause switch: anyone can see it (so menus can show "ordering is paused"), only staff change it.
    match /restaurants/{rid}/public/status {
      allow get: if true;
      allow create, update: if isStaff(rid)
        && request.resource.data.keys().hasOnly(['orderingPaused', 'updatedAt', 'updatedBy'])
        && request.resource.data.orderingPaused is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    // Sold-out dishes: anyone can see the list (menus grey those dishes out), only staff change it.
    // items holds dish ids like "item-106".
    match /restaurants/{rid}/public/soldout {
      allow get: if true;
      allow create, update: if isStaff(rid)
        && request.resource.data.keys().hasOnly(['items', 'updatedAt', 'updatedBy'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 300
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    // Guest ratings: one per order (the document id is the order id), only once staff have marked it served.
    // items maps dish ids to 1–5 stars. Staff read them, and mark each one counted once it's in the averages.
    match /restaurants/{rid}/ratings/{orderId} {
      allow create: if rid in staffEmails()
        && exists(/databases/$(database)/documents/restaurants/$(rid)/orders/$(orderId))
        && get(/databases/$(database)/documents/restaurants/$(rid)/orders/$(orderId)).data.status == 'served'
        && request.resource.data.keys().hasAll(['order', 'items', 'comment', 'createdAt', 'counted'])
        && request.resource.data.keys().hasOnly(['order', 'items', 'comment', 'phone', 'createdAt', 'counted'])
        && request.resource.data.order == orderId
        && request.resource.data.items is map
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 60
        && request.resource.data.items.values().hasOnly([1, 2, 3, 4, 5])
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 500
        // optional Indian mobile number (10 digits, starting 6–9), only staff can read it
        && (!('phone' in request.resource.data) || request.resource.data.phone == ''
            || (request.resource.data.phone is string && request.resource.data.phone.matches('^[6-9][0-9]{9}$')))
        && request.resource.data.createdAt == request.time
        && request.resource.data.counted == false;
      allow get, list: if isStaff(rid);
      allow update: if isStaff(rid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counted'])
        && request.resource.data.counted == true;
      allow delete: if false;
    }

    // Dish averages shown on the menu: anyone can read them, only staff (the staff screen) update them.
    match /restaurants/{rid}/public/ratings {
      allow get: if true;
      allow create, update: if isStaff(rid)
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.items is map
        && request.resource.data.updatedAt == request.time;
    }

    // Everything else is closed.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
